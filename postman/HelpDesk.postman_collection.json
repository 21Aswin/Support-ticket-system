    {
      "name": "Tickets Management",
      "item": [
        {
          "name": "1. Create Ticket (Employee/Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Laptop cannot connect to office Wi-Fi\",\n  \"description\": \"Cannot connect to Corp-Secure SSID after password rotation.\",\n  \"category_id\": 3,\n  \"priority\": \"High\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            }
          }
        },
        {
          "name": "2. List Tickets (Scoped by Role)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?status=Open&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"],
              "query": [
                { "key": "status", "value": "Open" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "3. Get Ticket Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}"]
            }
          }
        },
        {
          "name": "4. Assign Ticket (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigned_to\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "assign"]
            }
          }
        },
        {
          "name": "5. Update Status: Start Work (Support Staff)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{supportToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "status"]
            }
          }
        },
        {
          "name": "6. Update Status: Resolve (Support Staff)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{supportToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Resolved\",\n  \"resolution\": \"Renewed 802.1x enterprise certificate and flushed DNS.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "status"]
            }
          }
        },
        {
          "name": "7. Update Status: Close (Employee/Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Closed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "status"]
            }
          }
        }
