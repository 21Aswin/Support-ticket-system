# ============================================================
# HelpDesk Backend REST API - Production Environment Config
# Rename this file to '.env' inside the 'backend/' directory
# ============================================================

# Server Port & Timezone
PORT=3000
NODE_ENV=production
TZ=Asia/Kolkata

# OPTION 1: Cloud PostgreSQL Connection String (Recommended for Hostinger Web Hosting via Neon.tech or Supabase.com)
# DATABASE_URL=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/helpdesk_db?sslmode=require
# DB_SSL=true

# OPTION 2: Individual Database Connection Parameters (For Hostinger VPS or local PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=helpdesk_db
DB_USER=postgres
DB_PASSWORD=your_strong_db_password
DB_SSL=false

# Authentication Security (Change to a unique random 64-char string)
JWT_SECRET=helpdesk_prod_secret_key_change_me_to_random_long_string_2026
JWT_EXPIRES_IN=24h
